{% block survey_content %}
<div id="tl_buttons">
<a href="{{ hrefBack }}" class="header_back" title="{{ back }}" accesskey="b" data-action="contao--scroll-offset#store">{{ back }}</a>
</div>
<h2 class="sub_headline">{{ heading }}</h2>
<table cellpadding="0" cellspacing="0" class="tl_show" summary="{{ summary }}">
{% for data in data %}	
  <tr>
    <td class="{{ data["keyclass"] }}"><span class="tl_label">{{ data["key"] }}</span></td>
    <td class="{{ data["valueclass"] }}">{{ data["value"]|raw }}</td>
  </tr>
{% endfor %}
</table>
{% endblock %}
